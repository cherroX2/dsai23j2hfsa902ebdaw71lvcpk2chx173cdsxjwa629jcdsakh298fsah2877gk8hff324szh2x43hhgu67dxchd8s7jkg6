-- HSV to RGB conversion for rainbow
local function HSVtoRGB(h, s, v)
    local r, g, b
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    elseif i == 5 then r, g, b = v, p, q
    end
    return Color3.fromRGB(r * 255, g * 255, b * 255)
end

-- 3D Reach Circle at player's feet (non-filled outline)
local ReachCircleParts = {}

local function createReachCircle()
    -- Clear old parts
    for _, part in pairs(ReachCircleParts) do
        if part then part:Destroy() end
    end
    ReachCircleParts = {}
    
    -- Create circle outline using multiple parts
    local numParts = 60 -- More parts = smoother circle
    local angleStep = (math.pi * 2) / numParts
    
    for i = 1, numParts do
        local angle = angleStep * i
        local part = Instance.new("Part")
        part.Name = "ReachIndicatorSegment"
        part.Size = Vector3.new(0.3, 0.3, 0.5) -- Small segment
        part.Material = Enum.Material.Neon
        part.Color = ReachColorNormal
        part.Transparency = 0.3
        part.CanCollide = false
        part.Anchored = true
        part.Parent = workspace
        
        table.insert(ReachCircleParts, part)
    end
end

local function updateReachCirclePosition(rootPosition)
    if #ReachCircleParts == 0 then return end
    
    local numParts = #ReachCircleParts
    local angleStep = (math.pi * 2) / numParts
    
    for i, part in ipairs(ReachCircleParts) do
        if part and part.Parent then
            local angle = angleStep * i
            local x = math.cos(angle) * ReachSize
            local z = math.sin(angle) * ReachSize
            local segmentPos = rootPosition + Vector3.new(x, -3, z)
            
            -- Point towards center
            part.CFrame = CFrame.new(segmentPos, rootPosition + Vector3.new(0, -3, 0))
        end
    end
end

local function setReachCircleColor(color, isRainbow)
    if isRainbow then
        -- Rainbow animation - each segment gets different color
        local numParts = #ReachCircleParts
        for i, part in ipairs(ReachCircleParts) do
            if part and part.Parent then
                -- Calculate hue based on position + time offset for movement
                local hue = ((i / numParts) + RainbowOffset) % 1
                part.Color = HSVtoRGB(hue, 1, 1)
            end
        end
    else
        -- Solid color
        for _, part in ipairs(ReachCircleParts) do
            if part and part.Parent then
                part.Color = color
            end
        end
    end
end

local function destroyReachCircle()
    for _, part in pairs(ReachCircleParts) do
        if part then part:Destroy() end
    end
    ReachCircleParts = {}
end

