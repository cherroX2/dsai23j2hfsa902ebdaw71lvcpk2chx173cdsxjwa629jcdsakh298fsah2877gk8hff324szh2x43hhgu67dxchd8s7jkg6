-- Helper: Validation Logic
local function IsValid(plr)
    if plr and plr.Character and plr.Character:FindFirstChild(AimPart) and plr.Character:FindFirstChild("Humanoid") then
        local isAlive = plr.Character.Humanoid.Health > 0
        local isNotWhitelisted = not getgenv().WhitelistedPlayers[plr.Name]
        return isAlive and isNotWhitelisted
    end
    return false
end

-- Helper: Local Integrity
local function IsLocalAlive()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health > 0
end

-- Main RenderLoop: FOV and Aim Assist
RunService.RenderStepped:Connect(function()
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local originPos = (AimMethod == "Mouse") and UserInputService:GetMouseLocation() or Center
    
    -- FOV Rendering
    if ShowFOV and AimAssistEnabled and IsLocalAlive() then
        FOVCircle.Position = originPos
        FOVCircle.Radius = FOVRadius
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end
    
    -- 3D Reach Indicator Rendering (Circle at feet)
    if ShowReachIndicator and ReachEnabled and IsLocalAlive() then
        local character = LocalPlayer.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if humanoidRootPart then
            -- Create circle if it doesn't exist
            if #ReachCircleParts == 0 then
                createReachCircle()
            end
            
            -- Update circle position
            if #ReachCircleParts > 0 then
                updateReachCirclePosition(humanoidRootPart.Position)
            end
            
            -- Check if any enemy is in range (only check when sword equipped for accurate detection)
            local sword = character:FindFirstChildOfClass("Tool")
            local enemyInRange = false
            
            if sword and sword:FindFirstChild("Handle") then
                for _, targetPlayer in pairs(Players:GetPlayers()) do
                    if targetPlayer ~= LocalPlayer and not getgenv().WhitelistedPlayers[targetPlayer.Name] then
                        if targetPlayer.Character then
                            local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if targetHRP then
                                local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
                                if distance <= ReachSize then
                                    enemyInRange = true
                                    break
                                end
                            end
                        end
                    end
                end
            end
            
            -- Update rainbow offset for animation
            RainbowOffset = RainbowOffset + 0.01
            if RainbowOffset > 1 then RainbowOffset = 0 end
            
            -- Change color based on enemy presence
            if enemyInRange then
                setReachCircleColor(ReachColorActive, RainbowActive)
            else
                setReachCircleColor(ReachColorNormal, RainbowNormal)
            end
        else
            -- Hide circle when character doesn't exist
            destroyReachCircle()
        end
    else
        -- Hide circle when indicator disabled
        destroyReachCircle()
    end

    -- Aim Assist Execution
    if AimAssistEnabled and IsLocalAlive() then
        local target = nil

        -- Sticky Logic Priority
        if StickyAim and LockedTarget and IsValid(LockedTarget) then
            local pos, onScreen = Camera:WorldToViewportPoint(LockedTarget.Character[AimPart].Position)
            local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
            if onScreen and dist <= FOVRadius then
                target = LockedTarget
            end
        end

        -- Search for nearest target in FOV
        if not target then
            local lastDist = FOVRadius
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and IsValid(player) then
                    local pos, onScreen = Camera:WorldToViewportPoint(player.Character[AimPart].Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
                        if dist < lastDist then
                            lastDist = dist
                            target = player
                            if StickyAim then LockedTarget = player end
                        end
                    end
                end
            end
        end

        -- Execute Aim
        if target then
            local targetPart = target.Character[AimPart]
            local finalTargetPos = targetPart.Position
            
            if PredictionEnabled then
                local vel = targetPart.Velocity
                finalTargetPos = finalTargetPos + Vector3.new(vel.X * PredictionX, vel.Y * PredictionY, vel.Z * PredictionX)
            end

            if AimMethod == "Camera" then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, finalTargetPos), AimSmoothness)
            elseif AimMethod == "Mouse" then
                local screenPos = Camera:WorldToViewportPoint(finalTargetPos)
                local mPos = UserInputService:GetMouseLocation()
                mousemoverel((screenPos.X - mPos.X) * AimSmoothness, (screenPos.Y - mPos.Y) * AimSmoothness)
            end
        end
    else
        LockedTarget = nil
    end
end)

-- [[ 6. SWORD-BASED REACH MECHANIC (NO FLING!) ]]

-- Stepped Loop: Sword-Based Reach System
RunService.Stepped:Connect(function()
    if not ReachEnabled then return end
    
    pcall(function()
        if not IsLocalAlive() then return end
        
        local character = LocalPlayer.Character
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        -- Check if player is holding a sword/tool
        local sword = character:FindFirstChildOfClass("Tool")
        if sword and sword:FindFirstChild("Handle") then
            -- Loop through all players
            for _, targetPlayer in pairs(Players:GetPlayers()) do
                if targetPlayer ~= LocalPlayer and not getgenv().WhitelistedPlayers[targetPlayer.Name] then
                    if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Left Arm") and targetPlayer.Character:FindFirstChild("Right Leg") then
                        local targetCharacter = targetPlayer.Character
                        local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")
                        
                        if targetHRP then
                            -- Calculate distance
                            local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
                            
                            -- If within reach distance
                            if distance <= ReachSize then
                                local rightLeg = targetCharacter:FindFirstChild("Right Leg")
                                if rightLeg then
                                    pcall(function()
                                        -- Break joints and teleport leg to your position
                                        rightLeg:BreakJoints()
                                        rightLeg.Transparency = 1  -- Always invisible
                                        rightLeg.CanCollide = false
                                        rightLeg.CFrame = humanoidRootPart.CFrame * CFrame.new(1, 0, -3.5)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    -- Defense Logic (Ultra Tank & Desync)
    if IsLocalAlive() then
        if TankActive then
            LocalPlayer.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            LocalPlayer.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
        if DesyncActive then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local oldV = root.Velocity
                root.Velocity = Vector3.new(0, -200, 0)
                RunService.RenderStepped:Wait()
                root.Velocity = oldV
            end
        end
    end
end)

